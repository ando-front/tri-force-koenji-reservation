# --- Supabase / PostgreSQL ---------------------------------------------------
# Supabase プロジェクト作成後、Project Settings > Database > Connection string から取得。
# ローカル開発では `postgres://postgres:postgres@localhost:5432/tfk` などでも動作確認可能。
DATABASE_URL="postgres://postgres:postgres@localhost:5432/tfk"

NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxx"
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxx"

# --- Rate limiting (Vercel KV / Upstash) -------------------------------------
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Monitoring ---------------------------------------------------------------
SENTRY_DSN=""

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
