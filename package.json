{
  "name": "tri-force-koenji-reservation",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @tfk/db db:generate",
    "db:migrate": "pnpm --filter @tfk/db db:migrate",
    "db:seed": "pnpm --filter @tfk/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
